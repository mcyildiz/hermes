# Writes ${OUT} with HERMES_BUILD_VERSION: `git describe` when the source is
# a git checkout, else a hash of the sources. Runs on every build; the file
# is only rewritten when the version changes.
execute_process(COMMAND git -C "${SRC}" rev-parse --show-toplevel
                OUTPUT_VARIABLE top RESULT_VARIABLE rc OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
set(v "")
if(rc EQUAL 0)
  get_filename_component(top_real "${top}" REALPATH)
  get_filename_component(src_real "${SRC}" REALPATH)
  if(top_real STREQUAL src_real)
    execute_process(COMMAND git -C "${SRC}" describe --always --dirty --tags
                    OUTPUT_VARIABLE v RESULT_VARIABLE rc2 OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(NOT rc2 EQUAL 0)
      set(v "")
    endif()
  endif()
endif()
if(v STREQUAL "")
  file(GLOB_RECURSE files "${SRC}/src/*.cpp" "${SRC}/src/*.hpp" "${SRC}/include/*.hpp" "${SRC}/apps/*.cpp"
       "${SRC}/python/*.cpp")
  list(SORT files)
  set(acc "")
  foreach(f IN LISTS files)
    file(SHA1 "${f}" h)
    string(APPEND acc "${h}")
  endforeach()
  string(SHA1 hh "${acc}")
  string(SUBSTRING "${hh}" 0 12 hh)
  set(v "src-${hh}")
endif()
set(content "#pragma once\n#define HERMES_BUILD_VERSION \"${VERSION} ${v} (${BUILD_TYPE})\"\n")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
else()
  set(old "")
endif()
if(NOT old STREQUAL content)
  file(WRITE "${OUT}" "${content}")
endif()
